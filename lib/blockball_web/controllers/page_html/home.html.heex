<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>blockball</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={~p"/assets/app.css"} />
    <script id="blockball-auth-config" type="application/json"><%= Phoenix.HTML.raw(Jason.encode!(@auth_config)) %></script>
    <script id="blockball-physics-config" type="application/json"><%= Phoenix.HTML.raw(Jason.encode!(@physics_config)) %></script>
    <script defer src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="pitch-bg">
    <main id="app">
      <%!-- ============================================================
            LANDING
            ============================================================ --%>
      <section class="screen" data-screen="landing">
        <.top_nav />


        <div class="landing-stage">
          <div class="landing-hero">
            <div class="landing-copy">
              <h1 class="landing-title">
                Pure-skill soccer.<br />
                <span class="accent">On the record.</span>
              </h1>

              <div class="landing-actions landing-actions-split" aria-label="Quick match actions">
                <button class="cta-button secondary" data-action="play-casual">
                  <span class="cta-title">Play</span>
                  <span class="cta-sub">No sign-up needed</span>
                </button>
                <button class="cta-button" data-action="play-ranked">
                  <span class="cta-title">Compete</span>
                  <span class="cta-sub">Sign-up required</span>
                </button>
              </div>
            </div>

            <div class="court-preview" aria-hidden="true">
              <div class="court-header">
                <span class="court-chip red">RED</span>
                <span class="court-clock">02:00</span>
                <span class="court-chip blue">BLUE</span>
              </div>
              <div class="court-frame">
                <span class="goal-zone red"></span>
                <span class="goal-zone blue"></span>
                <span class="center-line"></span>
                <span class="center-ring"></span>
                <span class="trajectory one"></span>
                <span class="trajectory two"></span>
                <span class="player-dot red striker"></span>
                <span class="player-dot blue keeper"></span>
                <span class="puck"></span>
              </div>
            </div>
          </div>

          <dl id="features" class="landing-features" aria-label="Match format">
            <div class="feature">
              <dt>Team physics</dt>
              <dd>Wide field, circle players, puck-like ball, kick timing.</dd>
            </div>
            <div class="feature">
              <dt>Live rooms</dt>
              <dd>Practice bot, public room list, chat, score clock.</dd>
            </div>
            <div class="feature">
              <dt>Result ledger</dt>
              <dd>Replay hash, server signature, season ranking payload.</dd>
            </div>
          </dl>
        </div>
      </section>

      <%!-- ============================================================
            SIGNUP
            ============================================================ --%>
      <section class="screen" data-screen="signup" hidden>
        <.top_nav>
          <button class="ghost-button small" data-action="back-to-landing">← Back</button>
        </.top_nav>

        <div class="modal-stage">
          <div class="auth-card">
            <div class="auth-intro">
              <p class="eyebrow"><span class="num">01</span> Ranked Account</p>
              <h2>Sign in before kickoff</h2>
              <p class="muted small">
                Ranked play needs a server-verified wallet-backed account. Casual matches do not require this step.
              </p>
            </div>

            <div class="auth-panel">
              <form id="privy-email-form" class="stack">
                <label>
                  Email
                  <input id="privy-email-input" name="email" type="email" autocomplete="email" placeholder="player@example.com" />
                </label>
                <button type="submit" class="cta-button">
                  <span>Email sign in</span>
                  <span class="arrow">→</span>
                </button>
              </form>

              <form id="privy-code-form" class="stack" hidden>
                <label>
                  Verification code
                  <input id="privy-code-input" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="10" placeholder="123456" />
                </label>
              </form>

              <p id="auth-status" class="auth-status muted small" aria-live="polite"></p>

              <div class="row end">
                <button id="auth-continue-button" type="button" class="cta-button" data-action="auth-continue" hidden disabled>
                  <span>Continue</span>
                  <span class="arrow">→</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <%!-- ============================================================
            NICKNAME
            ============================================================ --%>
      <section class="screen" data-screen="nickname" hidden>
        <.top_nav>
          <span id="nickname-mode-tag" class="mode-tag casual" hidden>Casual</span>
          <span class="wallet-tag" id="nickname-wallet" hidden>Wallet · —</span>
          <button class="ghost-button small" data-action="sign-out" id="nickname-signout-btn" hidden>Sign out</button>
        </.top_nav>

        <div class="screen-back-row">
          <button class="ghost-button small" data-action="back-to-landing" id="nickname-back-btn">← Back</button>
        </div>

        <div class="modal-stage">
          <div class="modal-card narrow">
            <h2>Pick a nickname</h2>

            <form id="nickname-form" class="stack">
              <label>
                Nickname
                <input id="nickname-input" name="nickname" maxlength="18" minlength="2" autocomplete="nickname" placeholder="e.g. NEON_K" required />
              </label>
              <div class="row end">
                <button type="submit" class="cta-button">
                  <span>Continue</span>
                  <span class="arrow">→</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </section>

      <%!-- ============================================================
            LOBBY
            ============================================================ --%>
      <section class="screen" data-screen="lobby" hidden>
        <.top_nav>
          <span class="wallet-tag" id="lobby-wallet" hidden>Wallet · —</span>
          <span class="nick-tag">Player · <strong id="lobby-nick">—</strong></span>
          <button class="ghost-button small" data-action="change-nick">Change</button>
          <button class="ghost-button small" data-action="open-profile" id="lobby-profile-btn" hidden>Profile</button>
          <button class="ghost-button small" data-action="open-players" id="lobby-players-btn" hidden>Players</button>
          <button class="ghost-button small" data-action="sign-out" id="lobby-signout-btn" hidden>Sign out</button>
        </.top_nav>

        <div class="modal-stage">
          <div class="modal-card wide">
            <div class="modal-header">
              <div>
                <p class="eyebrow"><span class="num">03</span> Open Rooms</p>
                <h2>Lobby</h2>
              </div>
              <p class="lobby-meta-text">
                <strong id="lobby-meta">0 players · 0 rooms</strong>
                <span>active now</span>
              </p>
            </div>

            <div class="lobby-grid">
              <div class="room-table-wrap">
                <table class="room-table">
                  <thead>
                    <tr>
                      <th>Room</th>
                      <th>Mode</th>
                      <th>Type</th>
                      <th>Players</th>
                      <th>Status</th>
                      <th aria-label="actions"></th>
                    </tr>
                  </thead>
                  <tbody id="room-rows">
                    <tr class="empty"><td colspan="6">Loading rooms…</td></tr>
                  </tbody>
                </table>
              </div>

              <aside class="lobby-actions">
                <button class="cta-button" data-action="practice">
                  <span>Practice vs bot</span>
                  <span class="arrow">→</span>
                </button>
                <button class="secondary-button" data-action="open-create">Create room</button>
                <button class="ghost-button" data-action="refresh-rooms">
                  <span aria-hidden="true">↻</span>
                  Refresh
                </button>
                <p class="lobby-help">
                  Pick team size (1v1–4v4) when creating a room. The host starts the match once everyone has joined.
                </p>
              </aside>
            </div>

            <div id="create-room-panel" class="create-panel" hidden>
              <p class="eyebrow"><span class="num">03</span> New <span id="create-room-mode-label">Casual</span> Room</p>
              <form id="create-room-form" class="row" style="margin-top: var(--s-3)">
                <label class="grow">
                  Room name
                  <input id="create-room-name" maxlength="28" placeholder="e.g. 2v2" required />
                </label>
                <label>
                  Mode
                  <select id="create-room-mode">
                    <option value="vs1">1 vs 1</option>
                    <option value="vs2" selected>2 vs 2</option>
                    <option value="vs3">3 vs 3</option>
                    <option value="vs4">4 vs 4</option>
                    <option value="practice">Practice (bot only)</option>
                  </select>
                </label>
                <div class="row end">
                  <button type="button" class="ghost-button" data-action="close-create">Cancel</button>
                  <button type="submit" class="cta-button">Create</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </section>

      <%!-- ============================================================
            PROFILE
            ============================================================ --%>
      <section class="screen" data-screen="profile" hidden>
        <.top_nav>
          <button class="ghost-button small" data-action="back-to-lobby-from-profile">← Back</button>
        </.top_nav>

        <div class="modal-stage">
          <div class="modal-card narrow">
            <div class="auth-intro">
              <p class="eyebrow">Account</p>
              <h2>Your on-chain profile</h2>
              <p class="muted small">Stored in the <code>UserRegistry</code> contract.</p>
            </div>

            <dl class="profile-list">
              <div class="profile-row">
                <dt>Nickname</dt>
                <dd id="profile-nickname">—</dd>
              </div>
              <div class="profile-row">
                <dt>Wallet</dt>
                <dd id="profile-wallet" class="mono">—</dd>
              </div>
              <div class="profile-row">
                <dt>Identifier hash</dt>
                <dd id="profile-identifier" class="mono">—</dd>
              </div>
              <div class="profile-row">
                <dt>Contract</dt>
                <dd id="profile-contract" class="mono">—</dd>
              </div>
              <div class="profile-row">
                <dt>Chain</dt>
                <dd id="profile-chain">—</dd>
              </div>
            </dl>

            <p id="profile-status" class="auth-status muted small" aria-live="polite"></p>

            <div class="row end">
              <button type="button" class="ghost-button" data-action="change-nick">Change nickname</button>
            </div>
          </div>
        </div>
      </section>

      <%!-- ============================================================
            PLAYERS
            ============================================================ --%>
      <section class="screen" data-screen="players" hidden>
        <.top_nav>
          <button class="ghost-button small" data-action="back-to-lobby-from-players">← Back</button>
        </.top_nav>

        <div class="modal-stage">
          <div class="modal-card wide">
            <div class="modal-header">
              <div>
                <p class="eyebrow">Registry</p>
                <h2>Registered players</h2>
              </div>
              <p class="lobby-meta-text">
                <strong id="players-count">0 players</strong>
                <span>on-chain</span>
              </p>
            </div>

            <p id="players-status" class="auth-status muted small" aria-live="polite">Loading…</p>

            <div class="room-table-wrap">
              <table class="room-table">
                <thead>
                  <tr>
                    <th>Nickname</th>
                    <th>Wallet</th>
                    <th>Identifier</th>
                    <th>Block</th>
                    <th aria-label="tx"></th>
                  </tr>
                </thead>
                <tbody id="players-rows">
                  <tr class="empty"><td colspan="5">Loading on-chain players…</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <%!-- ============================================================
            GAME
            ============================================================ --%>
      <section class="screen game-screen" data-screen="game" hidden>
        <div class="game-shell">

          <%!-- ARENA --%>
          <section class="arena-column" aria-label="Game arena">
            <div class="scorebug idle" id="scorebug" aria-live="polite">
              <div class="scorebug-side red">
                <span class="kit-mark">R</span>
                <strong id="red-score" class="score">0</strong>
              </div>

              <div class="scorebug-core">
                <strong id="match-timer" class="clock">2:00</strong>
                <span class="live-pill">
                  <span class="live-dot"></span>
                  <span id="match-state">Waiting</span>
                </span>
              </div>

              <div class="scorebug-side blue">
                <strong id="blue-score" class="score">0</strong>
                <span class="kit-mark">B</span>
              </div>
            </div>

            <div class="canvas-wrap">
              <canvas id="game-canvas" width="1600" height="900" aria-label="blockball game canvas"></canvas>
              <div id="canvas-empty" class="canvas-empty">
                <span class="empty-eyebrow">Awaiting kickoff</span>
                <span class="empty-title">Enter a room</span>
              </div>
              <div id="waiting-room-overlay" class="waiting-overlay" hidden>
                <div class="waiting-card">
                  <p class="eyebrow">Waiting Room</p>
                  <h2 id="waiting-room-title" class="waiting-title">Room</h2>
                  <p class="waiting-count">
                    <span id="waiting-player-count">0</span> / <span id="waiting-capacity">2</span> ready
                  </p>
                  <ul id="waiting-roster" class="waiting-roster"></ul>
                  <button id="start-match-btn" class="cta-button" type="button" disabled>
                    Waiting for host…
                  </button>
                  <p id="waiting-hint" class="waiting-hint"></p>
                </div>
              </div>
            </div>
          </section>

          <%!-- MATCH RESULT — shown on game end --%>
          <div id="match-result" class="match-result" hidden>
            <div class="match-result-card" role="dialog" aria-modal="true" aria-labelledby="match-result-title">
              <span class="match-result-eyebrow">Final</span>
              <h2 id="match-result-title" class="match-result-title">—</h2>
              <div class="match-result-score">
                <span class="match-result-team red">
                  <span class="kit-dot red"></span>
                  <strong id="match-result-red">0</strong>
                </span>
                <span class="match-result-sep">—</span>
                <span class="match-result-team blue">
                  <strong id="match-result-blue">0</strong>
                  <span class="kit-dot blue"></span>
                </span>
              </div>
              <p id="match-result-receipt-status" class="receipt-status pending">
                Signed receipt pending chain confirmation.
              </p>
              <button type="button" class="cta-button" data-action="back-to-lobby">
                <span>Leave match</span>
                <span class="arrow">→</span>
              </button>
            </div>
          </div>

          <%!-- BOTTOM — chat dock --%>
          <section class="chat-dock" aria-label="Room chat">
            <form id="chat-form" class="chat-input-row">
              <input
                id="chat-input"
                type="text"
                maxlength="240"
                placeholder="Press Enter to chat…"
                autocomplete="off"
              />
              <button type="submit" class="primary-button small">Send</button>
            </form>
          </section>

        </div>
      </section>
    </main>

    <div id="toast" class="toast" hidden></div>
  </body>
</html>
